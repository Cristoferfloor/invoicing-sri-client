SRI_CLIENT_PORT=3004

# Base "invoicing" de Infrastructure/ (usuario core)
SRI_CLIENT_MONGO_URL=mongodb://core:CLAVE@mongo:27017/invoicing?authSource=admin&replicaSet=rs0

# Token para los endpoints /v1 (header X-Token-Admin)
SRI_CLIENT_ADMIN_TOKEN=

# SEGURO: con "false", ningun comprobante de ambiente 2 (produccion) sale al SRI.
SRI_CLIENT_ALLOW_PRODUCTION=false

# Ficha tecnica 2.26: maximo 50 comprobantes o 500 KB por lote
BATCH_MAX_DOCUMENTS=50
BATCH_MAX_BYTES=500000
# Serie reservada para las claves de lote
BATCH_SERIES=001001

# Maximo de comprobantes por llamada a /v1/envios
SEND_MAX_DOCUMENTS=500
SRI_TIMEOUT_MS=60000

# Modo automatico: envia los FIRMADO y consulta los ENVIADO sin Postman
SRI_CLIENT_AUTO=true
AUTO_PULSE_MS=3000
# Espera para juntar un lote desde el FIRMADO mas antiguo
BATCH_WAIT_MS=15000
# Segundos entre consultas de autorizacion (la ultima se repite)
SRI_QUERY_WAITS_SEC=3,10,30,60,120,300,600,1800

# Ambientes donde se intenta el lote (el SRI de pruebas no lo acepta). Ej: 2  o  1,2
BATCH_ENVIRONMENTS=2
